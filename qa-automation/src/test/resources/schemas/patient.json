{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Patient",
  "type": "object",
  "required": ["id", "firstName", "lastName", "dateOfBirth", "gender", "phone", "allergies", "createdAt"],
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "firstName": { "type": "string", "minLength": 1 },
    "lastName": { "type": "string", "minLength": 1 },
    "dateOfBirth": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "gender": { "type": "string", "enum": ["M", "F", "U"] },
    "phone": { "type": "string", "pattern": "^\\d{3}-\\d{3}-\\d{4}$" },
    "email": { "type": ["string", "null"] },
    "address": { "type": ["string", "null"] },
    "insurancePlan": { "type": ["string", "null"] },
    "allergies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "createdAt": { "type": "string" }
  }
}
