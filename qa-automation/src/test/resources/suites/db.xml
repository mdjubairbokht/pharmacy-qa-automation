<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="RxCare Database" verbose="1">
    <listeners>
        <listener class-name="com.rxcare.qa.listeners.SuiteListener"/>
        <listener class-name="com.rxcare.qa.listeners.TestListener"/>
    </listeners>

    <!-- Sequential on purpose: the ETL checks compare source and target totals at a point in time. -->
    <test name="Database - SQL validation, constraints and ETL">
        <packages>
            <package name="com.rxcare.qa.tests.db"/>
        </packages>
    </test>
</suite>
