<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Fast release gate (~1-2 min): critical path across API, DB and UI. Runs on every push. -->
<suite name="RxCare Smoke" verbose="1">
    <listeners>
        <listener class-name="com.rxcare.qa.listeners.SuiteListener"/>
        <listener class-name="com.rxcare.qa.listeners.TestListener"/>
        <listener class-name="com.rxcare.qa.listeners.RetryTransformer"/>
    </listeners>

    <test name="Smoke - API and DB" parallel="classes" thread-count="4">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="com.rxcare.qa.tests.api"/>
            <package name="com.rxcare.qa.tests.db"/>
        </packages>
    </test>

    <test name="Smoke - UI" parallel="classes" thread-count="2">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="com.rxcare.qa.tests.ui"/>
        </packages>
    </test>
</suite>
