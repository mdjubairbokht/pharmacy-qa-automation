      "port": 5432,
      "database": "pharmacy",
      "username": "pharmacy",
      "password": "pharmacy",
      "previewLimit": 50
    }
  ],
  "rest-client.environmentVariables": {
    "local": {
      "baseUrl": "http://localhost:8080"
    }
  }
}
